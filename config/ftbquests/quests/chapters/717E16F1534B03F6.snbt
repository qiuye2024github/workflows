	quests: [
		{
			description: [
				"使用植物盆栽可以种植植物"
				""
				"右键可以打开植物盆栽的GUI，GUI内上面格子是种子，下面是土壤，放上后就可以开始种。每个植物都有自己的基础生长时间，土壤决定了生长速度的倍率。把他们相乘就是最终需要生长的时间。"
				""
				"等生长完毕后，右键一下就可以获取产物了。漏式植物盆栽会在生长完成后自动收获，并存入下方的容器内"
			]
			id: "3B8B0006BE55F52E"
			rewards: [{
				exclude_from_claim_all: true
				id: "5016831D40850EFB"
				table_id: 4887006096378810986L
